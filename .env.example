# Required in production (app will not start without it)
SESSION_SECRET=generate-a-long-random-string-at-least-32-characters

# Optional SQLite file path (recommended in production to use a mounted disk path)
# DB_PATH=/var/data/stemverse.db

# Optional: port (default 3000; Render/similar set PORT automatically)
# PORT=3000

# Optional: server-side AI provider config (never expose in frontend)
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_DAILY_GLOBAL_LIMIT=500
# AI_DAILY_QUIZ_LIMIT_PER_USER=3
# AI_DAILY_RECOMMEND_LIMIT_PER_USER=5

# Backward-compatible alias if you prefer generic naming
# AI_API_KEY=...

# Frontend Supabase (safe public values)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend Supabase (server-only; do not expose in frontend)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ENABLE_TEST_ACCOUNTS=true
# ALLOW_LOCAL_AUTH_FALLBACK=false   # recommended false in production, true in local dev

# Optional app URL
# APP_URL=...
