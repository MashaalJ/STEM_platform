# Optional: port (default 3000; Render/similar set PORT automatically)
# PORT=3000
# If another app uses 3000, run: PORT=3001 npm run dev
# VITE_API_PORT=3001

# Supabase (required — database + auth)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-side AI provider config (never expose in frontend)
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_DAILY_GLOBAL_LIMIT=500
# AI_DAILY_QUIZ_LIMIT_PER_USER=3
# AI_DAILY_RECOMMEND_LIMIT_PER_USER=5
# AI_DAILY_STEMBOT_LIMIT_PER_USER=40

# Backward-compatible alias if you prefer generic naming
# AI_API_KEY=...

# Dev only: skip rate limits when header matches (never set in production)
# DEV_BYPASS_SECRET=stemverse-dev-2025
# VITE_DEV_BYPASS_SECRET=stemverse-dev-2025

# Optional security / deployment
# NODE_ENV=production
# FRONTEND_URL=https://stemverse.onrender.com
# ENABLE_TEST_ACCOUNTS=false
# DEFAULT_INDIVIDUAL_SCHOOL_NAME=STEMverse

# Apply database schema: run supabase/migrations/001_stemverse_schema.sql in Supabase SQL Editor
